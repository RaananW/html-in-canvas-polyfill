{
  "name": "@underglass/html-in-canvas-polyfill",
  "version": "0.4.0",
  "description": "Polyfill for the WICG HTML-in-Canvas proposal (drawElementImage, paint events, ElementImage).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/html-in-canvas-polyfill.git"
  },
  "homepage": "https://github.com/RaananW/html-in-canvas-polyfill#readme",
  "bugs": "https://github.com/RaananW/html-in-canvas-polyfill/issues",
  "keywords": [
    "html-in-canvas",
    "polyfill",
    "canvas",
    "drawElementImage",
    "wicg"
  ],
  "sideEffects": [
    "./dist/auto.js",
    "./dist/messaging.js",
    "./dist/worker.js",
    "./dist/html-in-canvas-polyfill.iife.js",
    "./dist/html-in-canvas-polyfill.worker.iife.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/types/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./iife": {
      "types": "./dist/types/iife.d.ts",
      "default": "./dist/html-in-canvas-polyfill.iife.js"
    },
    "./messaging": {
      "types": "./dist/types/messaging.d.ts",
      "default": "./dist/messaging.js"
    },
    "./worker": {
      "types": "./dist/types/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./worker/iife": {
      "default": "./dist/html-in-canvas-polyfill.worker.iife.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/LIMITATIONS.md",
    "docs/WORKERS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/build.mjs && playwright test",
    "size": "node scripts/size.mjs",
    "serve": "node scripts/serve.mjs",
    "bench": "node scripts/build.mjs && node scripts/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@typegpu/noise": "0.10.0",
    "@typegpu/sdf": "0.10.0",
    "@types/node": "^22.20.5",
    "@underglass/core": "0.2.2",
    "@underglass/ui": "0.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "gl-matrix": "2.8.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typegpu": "0.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-typegpu": "0.10.2",
    "vitest": "^5.1.0",
    "wgpu-matrix": "3.4.2"
  },
  "packageManager": "pnpm@11.23.0"
}
